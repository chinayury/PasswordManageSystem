# ============ 密码管理系统 环境变量示例 ============
# 复制为 .env 后按需修改。禁止把真实 .env 提交到代码仓库！

# --- 必填：安全密钥（缺失时应用拒绝启动） ---
# 生成方式：python -c "import os;print(os.urandom(32).hex())"
SECRET_KEY=change-me-64-hex-chars
# 生成方式：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 注意：一旦投入使用切勿更换，否则已存密码将无法解密
ENCRYPTION_KEY=change-me-fernet-key

# --- 运行环境 development / production / testing ---
APP_ENV=production

# --- 服务监听（wsgi.py / run.py 使用） ---
# HOST 安全提示：
#   127.0.0.1 = 仅本机访问（最稳，口令库不出本机，推荐单机自用）
#   0.0.0.0   = 对外监听。此时必须二选一：
#     a) 前置 nginx/Caddy 终结 TLS，并把 SESSION_COOKIE_SECURE 置 true
#        （同时 TRUST_PROXY=true，让服务拿到真实客户端 IP）；
#     b) 保持内网隔离 + 防火墙白名单，明确接受明文 HTTP 风险。
#   绑定 0.0.0.0 且未开安全 Cookie 时，服务启动会打印醒目安全告警。
# PORT/THREADS 非法值不会导致启动崩溃（告警并回退默认 8000/8）。
HOST=0.0.0.0
PORT=8000
THREADS=8

# --- 数据目录（默认在项目根目录，可指向独立数据盘） ---
# DATABASE_PATH=/data/password_manager.db
# UPLOAD_FOLDER=/data/uploads
# BACKUP_FOLDER=/data/backups
# LOG_FOLDER=/data/logs

# --- 邮件 SMTP（用于注册/找回密码验证码；不配置则这两个功能不可用） ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=noreply@example.com

# --- 业务开关 ---
ALLOW_REGISTER=true

# --- P4 密码健康审计（v0.1.0 第二轮新增） ---
# HIBP（Have I Been Pwned）泄露查询，默认关闭（零外联）。
# 开启后按 k-匿名协议仅发送口令 SHA-1 的前 5 位十六进制，明文与完整摘要不出服务端。
#HIBP_ENABLED=false
# 泄露查询 range 接口地址（默认官方地址；内网可自建代理）
#HIBP_RANGE_URL=https://api.pwnedpasswords.com/range/
# 单次请求超时（秒）
#HIBP_TIMEOUT_S=10
# 请求最小间隔（毫秒，官方建议 ≥100，防限流）
#HIBP_MIN_INTERVAL_MS=100
# 请求 User-Agent（HIBP 服务要求；不带版本号以减小指纹）
#HIBP_USER_AGENT=PasswordManageSystem
# 健康审计"口令使用超龄"阈值（天）
#HEALTH_MAX_AGE_DAYS=365

# --- HTTPS 部署后开启（Cookie 仅经 HTTPS 传输） ---
# true = 会话 Cookie 仅经 HTTPS 传输。**远程访问必须开启**，
# 否则登录态可被同网络第三方窃听。仅本机（HOST=127.0.0.1）可保持 false。
SESSION_COOKIE_SECURE=false

# --- 反向代理（v0.1.0 新增，S-05 后取末段） ---
# 仅当应用部署于可信反向代理（nginx 等）之后时置 true，
# 客户端 IP 取 X-Forwarded-For 的【末段】（单层可信代理时，
# 末段即代理观察到的真实对端；首段可被客户端伪造，不可采信）；
# 直连暴露时保持 false，防止客户端伪造 XFF 轮换"IP"
# 绕过 IP 限流与 用户名+IP 锁定。
# 实现见 app/security/ratelimit.py 的 client_ip()。
TRUST_PROXY=false

# --- 空闲会话自动锁定（借鉴 Psono autolock） ---
# 0=关闭（默认，行为与 v0.1.0 基线一致）；>0 时登录会话连续空闲超过
# N 分钟强制重新登录（离开工位防顶号）。静态资源不计入空闲计时。
#SESSION_IDLE_MINUTES=0

# --- 回收站保留期（借鉴 GB-56 · Bitwarden/Vaultwarden 回收站 30 天策略） ---
# 0=关闭（默认，与历史行为一致：回收站内容仅手动彻底删除）；>0 时服务
# 启动期自动彻底删除在回收站超过 N 天的记录（含附件文件）。
# 30 为对齐 Bitwarden 默认策略的推荐取值。
#RECYCLE_RETENTION_DAYS=0

# --- 日志级别 ---
LOG_LEVEL=INFO
